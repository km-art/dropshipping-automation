# Copy this file to .env and fill in your real values. Never commit .env.

# --- Shopify (or your store platform) ---
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_WEBHOOK_SECRET=your_webhook_signing_secret

# --- CJ Dropshipping (or swap for your supplier's API) ---
CJ_API_BASE=https://api.cjdropshipping.com/v1
CJ_API_KEY=your_cj_api_key

# --- Server ---
PORT=5000
